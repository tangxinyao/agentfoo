# agentfoo environment — copy to `.env` and fill in.
#
# The agentfoo CLI loads the nearest `.env` walking up from the working dir, so
# this file at the repo root is picked up even when you run from `example/`.
# Real exported env vars take precedence over anything set here.

# ── DeepSeek credentials & model wiring (used by example/agentfoo.config.ts) ──

# API key. Used by BOTH the judge (called from the host) and the in-container
# hermes (forwarded via `passEnv`). One value covers both.
DEEPSEEK_API_KEY=

# Model id, EXACTLY as DeepSeek's API expects it. Whatever you put here is sent
# verbatim as the API `model` field. Confirm against DeepSeek's model list —
# e.g. deepseek-flash.
DEEPSEEK_MODEL=deepseek-flash

# Agent-side provider wiring written into hermes' config.yaml. Confirm these two
# against a known-good DeepSeek run (the base_url may need a /v1 suffix).
DEEPSEEK_PROVIDER=deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── Other providers (judge + agent inference) ──
#
# Naming a provider (judge.model: 'glm/…' or agents.<name>.provider: 'glm') auto-
# fills its endpoint + key env var from src/providers.ts — you only need to set
# the key(s) below for the providers you actually use. See README → Providers.

# GLM (Zhipu / z.ai). Either var works; ZHIPUAI_API_KEY is checked first.
ZHIPUAI_API_KEY=
GLM_API_KEY=

# MiniMax.
MINIMAX_API_KEY=

# Kimi (Moonshot). Either var works; MOONSHOT_API_KEY is checked first.
MOONSHOT_API_KEY=
KIMI_API_KEY=

# ── Docker / build ──
#
# The agent (hermes) is pinned inside dockers/hermes.Dockerfile (HERMES_REF), so
# there's no source checkout to configure here — bump the version in that file.

# docker binary. Set to "sudo docker" if this host needs it; leave blank for
# plain "docker".
AGENTFOO_DOCKER=
