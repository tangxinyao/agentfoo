{"jsonrpc":"2.0","method":"session/update","params":{"sessionId":"019f9cbb-cc96-75fb-9f4a-4a877ec6eed4","update":{"sessionUpdate":"tool_call_update","toolCallId":"call_00_i1f6XZyaFVjebz7m7T030226","status":"completed","content":[{"type":"diff","path":"/workspace/index.html","oldText":null,"newText":"<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>ORIGAMI COFFEE · 折纸咖啡</title>\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n  <link href=\"https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;1,9..40,400&family=DM+Serif+Display:ital@0;1&family=Noto+Serif+SC:wght@400;600;700&family=Playfair+Display:ital,wght@0,700;0,800;1,700&display=swap\" rel=\"stylesheet\">\n  <style>\n    /* ── Design Tokens ── */\n    :root {\n      --paper: #F0EDE7;\n      --ink: #1C1814;\n      --copper: #C17F42;\n      --copper-dim: rgba(193, 127, 66, 0.12);\n      --copper-glow: rgba(193, 127, 66, 0.22);\n      --sage: #6D7F63;\n      --sage-dim: rgba(109, 127, 99, 0.08);\n      --stone: #D9D3CB;\n      --light: #FAF8F3;\n      --dark-surface: #1E1B17;\n\n      --font-display: 'Playfair Display', 'Noto Serif SC', serif;\n      --font-sub: 'DM Serif Display', 'Noto Serif SC', serif;\n      --font-body: 'DM Sans', system-ui, sans-serif;\n      --font-cn: 'Noto Serif SC', serif;\n    }\n\n    /* ── Reset & Base ── */\n    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }\n    html { scroll-behavior: smooth; -webkit-font-smoothing: antialiased; }\n    body {\n      font-family: var(--font-body);\n      background: var(--paper);\n      color: var(--ink);\n      line-height: 1.6;\n      font-size: clamp(1rem, 0.96rem + 0.2vw, 1.125rem);\n      overflow-x: hidden;\n    }\n\n    /* ── Utility ── */\n    .container {\n      width: min(90%, 72rem);\n      margin-inline: auto;\n    }\n    .sr-only {\n      position: absolute; width: 1px; height: 1px; overflow: hidden;\n      clip: rect(0,0,0,0); white-space: nowrap; border: 0;\n    }\n\n    /* ── Scroll Reveal ── */\n    .reveal {\n      opacity: 0;\n      transform: translateY(2rem);\n      transition: opacity 0.8s cubic-bezier(0.22, 0.61, 0.36, 1),\n                  transform 0.8s cubic-bezier(0.22, 0.61, 0.36, 1);\n    }\n    .reveal.visible {\n      opacity: 1;\n      transform: translateY(0);\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      .reveal { opacity: 1; transform: none; transition: none; }\n      * { animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; }\n    }\n\n    /* ── Nav ── */\n    .nav {\n      position: fixed; top: 0; left: 0; right: 0; z-index: 100;\n      padding: 1.5rem 0;\n      background: linear-gradient(to bottom, var(--paper) 0%, transparent 100%);\n    }\n    .nav-inner {\n      display: flex; justify-content: space-between; align-items: center;\n      width: min(90%, 72rem); margin-inline: auto;\n    }\n    .nav-logo {\n      font-family: var(--font-display);\n      font-size: 1.5rem; font-weight: 700; letter-spacing: 0.08em;\n      color: var(--ink); text-decoration: none;\n    }\n    .nav-cta {\n      font-family: var(--font-body);\n      font-size: 0.8rem; font-weight: 500; letter-spacing: 0.06em;\n      text-transform: uppercase; text-decoration: none;\n      color: var(--copper); border-bottom: 1px solid var(--copper);\n      padding-bottom: 2px; transition: opacity 0.3s;\n    }\n    .nav-cta:hover { opacity: 0.65; }\n\n    /* ── Hero ── */\n    .hero {\n      min-height: 100vh; display: flex; align-items: center;\n      padding: 6rem 0 4rem;\n    }\n    .hero-grid {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      gap: clamp(2rem, 6vw, 6rem);\n      align-items: center;\n      width: min(90%, 72rem); margin-inline: auto;\n    }\n    .hero-text { position: relative; z-index: 2; }\n    .hero-eyebrow {\n      font-family: var(--font-cn);\n      font-size: 0.95rem; letter-spacing: 0.12em;\n      color: var(--sage); margin-bottom: 1.5rem;\n    }\n    .hero-brand {\n      font-family: var(--font-display);\n      font-size: clamp(3.5rem, 8vw, 7rem);\n      font-weight: 800; line-height: 0.9;\n      letter-spacing: -0.02em; color: var(--ink);\n      margin-bottom: 0.5rem;\n    }\n    .hero-sub {\n      font-family: var(--font-cn);\n      font-size: clamp(1.1rem, 2vw, 1.5rem);\n      font-weight: 400; color: var(--sage);\n      margin-bottom: 2rem;\n    }\n    .hero-line {\n      width: 3rem; height: 1px; background: var(--copper);\n      margin-bottom: 2rem;\n    }\n    .hero-desc {\n      font-size: 0.95rem; color: rgba(28, 24, 20, 0.65);\n      max-width: 28ch; line-height: 1.8;\n    }\n\n    /* ── Hero Animation (SVG Pour-Over Scene) ── */\n    .hero-visual {\n      display: flex; align-items: center; justify-content: center;\n      position: relative;\n    }\n    .pour-scene {\n      width: min(100%, 340px);\n      height: auto;\n    }\n\n    /* Water stream animation */\n    .stream-path {\n      stroke-dasharray: 200;\n      stroke-dashoffset: 200;\n      animation: pour 4s ease-in-out infinite;\n    }\n    @keyframes pour {\n      0%   { stroke-dashoffset: 200; opacity: 0; }\n      15%  { opacity: 0.9; }\n      50%  { stroke-dashoffset: 0; opacity: 0.9; }\n      65%  { opacity: 0.9; }\n      80%  { stroke-dashoffset: 0; opacity: 0; }\n      100% { stroke-dashoffset: 0; opacity: 0; }\n    }\n\n    /* Ripple circles in the dripper */\n    .ripple {\n      animation: ripple 4s ease-out infinite;\n      transform-origin: center;\n      opacity: 0;\n    }\n    .ripple:nth-child(1) { animation-delay: 0.6s; }\n    .ripple:nth-child(2) { animation-delay: 1.1s; }\n    .ripple:nth-child(3) { animation-delay: 1.6s; }\n    @keyframes ripple {\n      0%   { r: 4; opacity: 0; }\n      15%  { opacity: 0.5; }\n      50%  { r: 28; opacity: 0; }\n      100% { r: 28; opacity: 0; }\n    }\n\n    /* Drip falling from dripper */\n    .drip {\n      animation: dripFall 4s ease-in infinite;\n      opacity: 0;\n    }\n    @keyframes dripFall {\n      0%   { transform: translateY(0); opacity: 0; }\n      20%  { opacity: 0.7; }\n      45%  { transform: translateY(28px); opacity: 0.7; }\n      55%  { transform: translateY(32px); opacity: 0; }\n      100% { transform: translateY(32px); opacity: 0; }\n    }\n\n    /* Steam wisps */\n    .steam {\n      animation: steamRise 5s ease-out infinite;\n      opacity: 0;\n    }\n    .steam:nth-child(1) { animation-delay: 0s; }\n    .steam:nth-child(2) { animation-delay: 1.7s; }\n    .steam:nth-child(3) { animation-delay: 3.3s; }\n    @keyframes steamRise {\n      0%   { transform: translateY(0) scaleX(1); opacity: 0; }\n      20%  { opacity: 0.25; }\n      60%  { transform: translateY(-26px) scaleX(1.6); opacity: 0; }\n      100% { transform: translateY(-26px) scaleX(1.6); opacity: 0; }\n    }\n\n    /* ── Section Common ── */\n    .section { padding: clamp(4rem, 10vw, 8rem) 0; }\n    .section-label {\n      font-family: var(--font-body);\n      font-size: 0.7rem; font-weight: 500; letter-spacing: 0.14em;\n      text-transform: uppercase; color: var(--sage);\n      margin-bottom: 1.5rem;\n    }\n    .section-title {\n      font-family: var(--font-sub);\n      font-size: clamp(2rem, 5vw, 3.5rem);\n      font-weight: 400; line-height: 1.15; letter-spacing: -0.01em;\n      color: var(--ink); margin-bottom: 1.5rem;\n    }\n    .section-body {\n      font-size: 1rem; color: rgba(28, 24, 20, 0.65);\n      max-width: 42ch; line-height: 1.85;\n    }\n\n    /* ── Philosophy ── */\n    .phil-grid {\n      display: grid;\n      grid-template-columns: 1fr 1.3fr;\n      gap: clamp(3rem, 8vw, 8rem);\n      align-items: start;\n    }\n    .phil-large {\n      font-family: var(--font-sub);\n      font-size: clamp(1.5rem, 3.5vw, 2.2rem);\n      line-height: 1.4; color: var(--ink);\n      letter-spacing: -0.01em;\n    }\n    .phil-large em {\n      font-style: italic; color: var(--copper);\n    }\n    .phil-detail {\n      font-size: 0.95rem; color: rgba(28, 24, 20, 0.55);\n      line-height: 1.9;\n    }\n    .phil-detail p + p { margin-top: 1.5rem; }\n\n    /* ── Origins ── */\n    .origins-strip {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 2px;\n      background: var(--stone);\n    }\n    @media (max-width: 900px) {\n      .origins-strip { grid-template-columns: 1fr; gap: 1px; }\n    }\n    .origin-card {\n      background: var(--paper);\n      padding: clamp(2.5rem, 5vw, 4rem);\n      display: flex; flex-direction: column;\n      justify-content: space-between;\n      min-height: 380px;\n      position: relative; overflow: hidden;\n      transition: background 0.5s;\n    }\n    .origin-card:hover { background: var(--light); }\n    .origin-country {\n      font-family: var(--font-body);\n      font-size: 0.65rem; font-weight: 500; letter-spacing: 0.16em;\n      text-transform: uppercase; color: var(--copper);\n      margin-bottom: 0.75rem;\n    }\n    .origin-name {\n      font-family: var(--font-sub);\n      font-size: clamp(1.6rem, 3vw, 2.2rem);\n      font-weight: 400; line-height: 1.2; letter-spacing: -0.01em;\n      color: var(--ink);\n    }\n    .origin-region {\n      font-family: var(--font-cn);\n      font-size: 0.85rem; color: rgba(28, 24, 20, 0.4);\n      margin-bottom: 2rem;\n    }\n    .origin-notes {\n      font-size: 0.85rem; color: var(--sage);\n      line-height: 1.8;\n    }\n    .origin-altitude {\n      font-family: var(--font-body);\n      font-size: 0.7rem; letter-spacing: 0.08em;\n      color: rgba(28, 24, 20, 0.3);\n      margin-top: 2rem;\n    }\n    .origin-card::after {\n      content: '';\n      position: absolute; top: -1px; left: 0; right: 0;\n      height: 2px; background: var(--copper);\n      transform: scaleX(0); transform-origin: left;\n      transition: transform 0.5s cubic-bezier(0.22, 0.61, 0.36, 1);\n    }\n    .origin-card:hover::after { transform: scaleX(1); }\n\n    /* ── Process ── */\n    .process-head {\n      text-align: center; margin-bottom: clamp(3rem, 6vw, 5rem);\n    }\n    .process-track {\n      display: grid;\n      grid-template-columns: repeat(4, 1fr);\n      gap: clamp(1.5rem, 3vw, 3rem);\n      position: relative;\n    }\n    @media (max-width: 768px) {\n      .process-track { grid-template-columns: 1fr 1fr; gap: 2.5rem; }\n    }\n    @media (max-width: 480px) {\n      .process-track { grid-template-columns: 1fr; }\n    }\n    .process-step { position: relative; }\n    .process-icon {\n      width: 56px; height: 56px; margin-bottom: 1.5rem;\n      display: flex; align-items: center; justify-content: center;\n      border-radius: 50%;\n      background: var(--sage-dim);\n      color: var(--sage);\n      transition: background 0.4s, color 0.4s;\n    }\n    .process-step:hover .process-icon {\n      background: var(--sage);\n      color: var(--light);\n    }\n    .process-num {\n      font-family: var(--font-display);\n      font-size: 0.8rem; font-weight: 700;\n      color: var(--stone); margin-bottom: 0.5rem;\n    }\n    .process-title {\n      font-family: var(--font-sub);\n      font-size: 1.25rem; color: var(--ink);\n      margin-bottom: 0.5rem;\n    }\n    .process-cn {\n      font-family: var(--font-cn);\n      font-size: 0.9rem; color: rgba(28, 24, 20, 0.4);\n      margin-bottom: 1rem;\n    }\n    .process-desc {\n      font-size: 0.85rem; color: rgba(28, 24, 20, 0.55);\n      line-height: 1.7;\n    }\n    /* Connecting line on desktop */\n    @media (min-width: 769px) {\n      .process-track::before {\n        content: ''; position: absolute; top: 28px;\n        left: calc(12.5% + 28px); right: calc(12.5% + 28px);\n        height: 1px; background: var(--stone);\n      }\n    }\n\n    /* ── CTA ── */\n    .cta-section {\n      background: var(--dark-surface);\n      padding: clamp(4rem, 10vw, 8rem) 0;\n      text-align: center; position: relative; overflow: hidden;\n    }\n    .cta-section::before {\n      content: '';\n      position: absolute; inset: 0;\n      background: radial-gradient(ellipse at 50% 30%, var(--copper-dim) 0%, transparent 60%);\n      pointer-events: none;\n    }\n    .cta-inner { position: relative; z-index: 1; }\n    .cta-eyebrow {\n      font-family: var(--font-body);\n      font-size: 0.7rem; font-weight: 500; letter-spacing: 0.14em;\n      text-transform: uppercase; color: var(--copper);\n      margin-bottom: 1.5rem;\n    }\n    .cta-title {\n      font-family: var(--font-sub);\n      font-size: clamp(2rem, 5vw, 3.5rem);\n      font-weight: 400; line-height: 1.15; letter-spacing: -0.01em;\n      color: var(--light); margin-bottom: 1.5rem;\n    }\n    .cta-body {\n      font-size: 1rem; color: rgba(250, 248, 243, 0.5);\n      max-width: 40ch; margin-inline: auto; line-height: 1.8;\n      margin-bottom: 2.5rem;\n    }\n    .cta-button {\n      display: inline-block;\n      font-family: var(--font-body);\n      font-size: 0.8rem; font-weight: 500; letter-spacing: 0.08em;\n      text-transform: uppercase; text-decoration: none;\n      color: var(--dark-surface); background: var(--copper);\n      padding: 1rem 2.5rem;\n      transition: background 0.3s, transform 0.3s;\n    }\n    .cta-button:hover { background: #d4954f; transform: translateY(-2px); }\n    .cta-button:focus-visible {\n      outline: 2px solid var(--copper); outline-offset: 3px;\n    }\n\n    /* ── Footer ── */\n    .footer {\n      background: var(--dark-surface);\n      padding: 3rem 0 2rem; border-top: 1px solid rgba(250, 248, 243, 0.06);\n    }\n    .footer-inner {\n      display: flex; justify-content: space-between; align-items: center;\n      width: min(90%, 72rem); margin-inline: auto;\n      flex-wrap: wrap; gap: 1.5rem;\n    }\n    .footer-brand {\n      font-family: var(--font-display);\n      font-size: 1.2rem; font-weight: 700; letter-spacing: 0.06em;\n      color: var(--light);\n    }\n    .footer-info {\n      font-size: 0.75rem; color: rgba(250, 248, 243, 0.3);\n    }\n    .footer-links {\n      display: flex; gap: 2rem;\n    }\n    .footer-links a {\n      font-size: 0.75rem; color: rgba(250, 248, 243, 0.3);\n      text-decoration: none; transition: color 0.3s;\n    }\n    .footer-links a:hover { color: var(--copper); }\n\n    /* ── Responsive Hero ── */\n    @media (max-width: 768px) {\n      .hero-grid {\n        grid-template-columns: 1fr;\n        text-align: center;\n        gap: 2rem;\n      }\n      .hero-visual { order: -1; }\n      .hero-line { margin-inline: auto; }\n      .hero-desc { max-width: none; margin-inline: auto; }\n      .pour-scene { width: min(80%, 260px); }\n      .phil-grid {\n        grid-template-columns: 1fr; gap: 2rem;\n      }\n    }\n\n    @media (max-width: 480px) {\n      .hero-brand { font-size: clamp(2.8rem, 12vw, 3.5rem); }\n      .pour-scene { width: min(70%, 200px); }\n      .footer-inner { flex-direction: column; text-align: center; }\n      .footer-links { justify-content: center; }\n    }\n  </style>\n</head>\n<body>\n\n  <!-- ── Nav ── -->\n  <nav class=\"nav\" role=\"navigation\" aria-label=\"主导航\">\n    <div class=\"nav-inner\">\n      <a href=\"#\" class=\"nav-logo\" aria-label=\"折纸咖啡首页\">ORIGAMI</a>\n      <a href=\"#cta\" class=\"nav-cta\">预约品鉴</a>\n    </div>\n  </nav>\n\n  <!-- ── Hero ── -->\n  <section class=\"hero\" aria-label=\"品牌介绍\">\n    <div class=\"hero-grid\">\n      <div class=\"hero-text reveal\">\n        <p class=\"hero-eyebrow\">精品手冲咖啡</p>\n        <h1 class=\"hero-brand\">ORIGAMI</h1>\n        <p class=\"hero-sub\">折纸咖啡</p>\n        <div class=\"hero-line\" aria-hidden=\"true\"></div>\n        <p class=\"hero-desc\">\n          每一滴都是时间的艺术。<br>\n          温度、研磨、水流与重力——在精确的交汇中，萃取出一杯透明而深邃的风味。\n        </p>\n      </div>\n\n      <!-- Pour-Over Animation Scene -->\n      <div class=\"hero-visual reveal\" aria-hidden=\"true\">\n        <svg class=\"pour-scene\" viewBox=\"0 0 300 360\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n          <!-- Dripper body (V60 shape) -->\n          <path d=\"M110 130 L190 130 L170 230 L130 230 Z\"\n                fill=\"none\" stroke=\"#D9D3CB\" stroke-width=\"1.5\" stroke-linejoin=\"round\" />\n          <!-- Dripper interior ridges -->\n          <line x1=\"116\" y1=\"155\" x2=\"184\" y2=\"155\" stroke=\"#D9D3CB\" stroke-width=\"0.7\" />\n          <line x1=\"122\" y1=\"175\" x2=\"178\" y2=\"175\" stroke=\"#D9D3CB\" stroke-width=\"0.7\" />\n          <line x1=\"126\" y1=\"195\" x2=\"174\" y2=\"195\" stroke=\"#D9D3CB\" stroke-width=\"0.7\" />\n          <!-- Dripper base ring -->\n          <rect x=\"128\" y=\"227\" width=\"44\" height=\"6\" rx=\"2\" fill=\"none\" stroke=\"#D9D3CB\" stroke-width=\"1.2\" />\n\n          <!-- Coffee bed (grounds) -->\n          <ellipse cx=\"150\" cy=\"228\" rx=\"46\" ry=\"10\" fill=\"rgba(28,24,20,0.18)\" />\n          <!-- Coffee bed top shimmer -->\n          <ellipse cx=\"150\" cy=\"225\" rx=\"40\" ry=\"7\" fill=\"rgba(28,24,20,0.1)\" />\n\n          <!-- Water stream from above -->\n          <path class=\"stream-path\"\n                d=\"M150 60 Q148 90 150 130\"\n                stroke=\"#C17F42\" stroke-width=\"1.8\" stroke-linecap=\"round\" fill=\"none\" />\n\n          <!-- Ripples in coffee bed -->\n          <circle class=\"ripple\" cx=\"150\" cy=\"225\" r=\"4\"\n                  fill=\"none\" stroke=\"#C17F42\" stroke-width=\"1\" />\n          <circle class=\"ripple\" cx=\"150\" cy=\"225\" r=\"4\"\n                  fill=\"none\" stroke=\"#C17F42\" stroke-width=\"0.8\" />\n          <circle class=\"ripple\" cx=\"150\" cy=\"225\" r=\"4\"\n                  fill=\"none\" stroke=\"#C17F42\" stroke-width=\"0.6\" />\n\n          <!-- Drip falling from dripper -->\n          <ellipse class=\"drip\" cx=\"150\" cy=\"234\" rx=\"3\" ry=\"5\" fill=\"#C17F42\" />\n\n          <!-- Carafe / receiving vessel -->\n          <path d=\"M125 270 Q125 260 135 258 L165 258 Q175 260 175 270 L185 340 Q185 350 175 350 L125 350 Q115 350 115 340 L125 270 Z\"\n                fill=\"none\" stroke=\"#D9D3CB\" stroke-width=\"1.5\" stroke-linejoin=\"round\" />\n          <!-- Carafe coffee level -->\n          <rect x=\"117\" y=\"315\" width=\"66\" height=\"33\" rx=\"1\" fill=\"rgba(193,127,66,0.13)\" />\n\n          <!-- Steam wisps above dripper -->\n          <path class=\"steam\" d=\"M142 118 Q138 105 142 94\"\n                stroke=\"#D9D3CB\" stroke-width=\"1.2\" stroke-linecap=\"round\" fill=\"none\" />\n          <path class=\"steam\" d=\"M150 114 Q147 100 151 88\"\n                stroke=\"#D9D3CB\" stroke-width=\"1\" stroke-linecap=\"round\" fill=\"none\" />\n          <path class=\"steam\" d=\"M158 117 Q155 104 159 92\"\n                stroke=\"#D9D3CB\" stroke-width=\"1.1\" stroke-linecap=\"round\" fill=\"none\" />\n        </svg>\n      </div>\n    </div>\n  </section>\n\n  <!-- ── Philosophy ── -->\n  <section class=\"section\" aria-labelledby=\"phil-heading\">\n    <div class=\"container\">\n      <div class=\"phil-grid\">\n        <div class=\"reveal\">\n          <p class=\"section-label\">我们的信念</p>\n          <p class=\"phil-large\">\n            一杯好咖啡不是偶然，<br>\n            而是 <em>温度、研磨、水流与时间</em><br>\n            的精确交汇。\n          </p>\n        </div>\n        <div class=\"phil-detail reveal\">\n          <p>\n            手冲，是最诚实的萃取方式。没有高压的伪装，没有奶泡的掩盖——每一颗豆子的风味，都在滤纸的缓慢滴滤中被如实呈现。我们只选用评分 85 分以上的单一产地精品豆，在最佳赏味期内手工烘焙，确保每一杯都经得起味蕾的审视。\n          </p>\n          <p>\n            从埃塞俄比亚的古优品种到哥伦比亚的高海拔庄园，我们与产地建立直接贸易关系，让每一粒豆子都可追溯至具体的农场与海拔。这不是营销话术，而是一个咖啡品牌对土地与人的基本尊重。\n          </p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- ── Origins ── -->\n  <section class=\"section\" aria-labelledby=\"origins-heading\" style=\"padding-top: 0;\">\n    <div class=\"container\" style=\"margin-bottom: 3rem;\">\n      <p class=\"section-label reveal\">产地精选</p>\n      <h2 id=\"origins-heading\" class=\"section-title reveal\">三支豆子，三种风土</h2>\n    </div>\n    <div class=\"origins-strip reveal\">\n      <article class=\"origin-card\">\n        <div>\n          <p class=\"origin-country\">Ethiopia</p>\n          <h3 class=\"origin-name\">Yirgacheffe</h3>\n          <p class=\"origin-region\">耶加雪菲 · 果丁丁合作社</p>\n          <p class=\"origin-notes\">茉莉花香 · 柑橘 · 蜂蜜</p>\n        </div>\n        <p class=\"origin-altitude\">海拔 1,950–2,100m · 水洗处理</p>\n      </article>\n      <article class=\"origin-card\">\n        <div>\n          <p class=\"origin-country\">Colombia</p>\n          <h3 class=\"origin-name\">Huila</h3>\n          <p class=\"origin-region\">蕙兰 · 圣奥古斯丁</p>\n          <p class=\"origin-notes\">焦糖 · 烤坚果 · 黑巧克力</p>\n        </div>\n        <p class=\"origin-altitude\">海拔 1,600–1,850m · 日晒处理</p>\n      </article>\n      <article class=\"origin-card\">\n        <div>\n          <p class=\"origin-country\">Kenya</p>\n          <h3 class=\"origin-name\">Nyeri</h3>\n          <p class=\"origin-region\">涅里 · 吉查撒尼处理厂</p>\n          <p class=\"origin-notes\">黑醋栗 · 圣女果 · 红酒余韵</p>\n        </div>\n        <p class=\"origin-altitude\">海拔 1,700–1,950m · 水洗处理</p>\n      </article>\n    </div>\n  </section>\n\n  <!-- ── Process ── -->\n  <section class=\"section\" aria-labelledby=\"process-heading\">\n    <div class=\"container\">\n      <div class=\"process-head reveal\">\n        <p class=\"section-label\" style=\"text-align: center;\">手冲仪式</p>\n        <h2 id=\"process-heading\" class=\"section-title\" style=\"margin-inline: auto; max-width: 20ch;\">\n          四步，还原风土的真相\n        </h2>\n      </div>\n      <div class=\"process-track reveal\">\n        <div class=\"process-step\">\n          <div class=\"process-icon\" aria-hidden=\"true\">\n            <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\">\n              <circle cx=\"12\" cy=\"12\" r=\"9\"/>\n              <circle cx=\"12\" cy=\"12\" r=\"4\"/>\n              <circle cx=\"12\" cy=\"12\" r=\"1.5\" fill=\"currentColor\"/>\n            </svg>\n          </div>\n          <p class=\"process-num\">01</p>\n          <h3 class=\"process-title\">Grind</h3>\n          <p class=\"process-cn\">研磨</p>\n          <p class=\"process-desc\">中细研磨，如粗砂糖的颗粒感。研磨度决定了水与咖啡的接触面积，是萃取的起手式。</p>\n        </div>\n        <div class=\"process-step\">\n          <div class=\"process-icon\" aria-hidden=\"true\">\n            <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\">\n              <circle cx=\"12\" cy=\"10\" r=\"7\"/>\n              <path d=\"M9 14 Q12 18 15 14\"/>\n              <circle cx=\"12\" cy=\"9\" r=\"2\" fill=\"currentColor\"/>\n            </svg>\n          </div>\n          <p class=\"process-num\">02</p>\n          <h3 class=\"process-title\">Bloom</h3>\n          <p class=\"process-cn\">焖蒸</p>\n          <p class=\"process-desc\">92°C 热水，两倍粉重注水，静候 30 秒。二氧化碳释出，咖啡粉膨胀——风味之门就此打开。</p>\n        </div>\n        <div class=\"process-step\">\n          <div class=\"process-icon\" aria-hidden=\"true\">\n            <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\">\n              <path d=\"M12 3 L12 21\"/>\n              <path d=\"M12 3 Q8 8 12 12 Q16 8 12 3\"/>\n              <circle cx=\"12\" cy=\"16\" r=\"2\" fill=\"currentColor\"/>\n            </svg>\n          </div>\n          <p class=\"process-num\">03</p>\n          <h3 class=\"process-title\">Pour</h3>\n          <p class=\"process-cn\">注水</p>\n          <p class=\"process-desc\">细口壶以同心圆轨迹缓慢注水，保持水位稳定。3 分钟内完成，每一圈都关乎风味的均衡释放。</p>\n        </div>\n        <div class=\"process-step\">\n          <div class=\"process-icon\" aria-hidden=\"true\">\n            <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\">\n              <rect x=\"5\" y=\"4\" width=\"14\" height=\"4\" rx=\"1\"/>\n              <path d=\"M7 8 L10 20 L14 20 L17 8\"/>\n              <line x1=\"10\" y1=\"12\" x2=\"14\" y2=\"12\"/>\n            </svg>\n          </div>\n          <p class=\"process-num\">04</p>\n          <h3 class=\"process-title\">Savor</h3>\n          <p class=\"process-cn\">品味</p>\n          <p class=\"process-desc\">趁热小口啜饮，让咖啡液在舌面均匀铺开。感受前段的果酸、中段的甜感、尾韵的悠长。</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- ── CTA ── -->\n  <section class=\"cta-section\" id=\"cta\" aria-labelledby=\"cta-heading\">\n    <div class=\"cta-inner container\">\n      <p class=\"cta-eyebrow reveal\">预约品鉴</p>\n      <h2 id=\"cta-heading\" class=\"cta-title reveal\">\n        来喝一杯吧\n      </h2>\n      <p class=\"cta-body reveal\">\n        我们的品鉴室每周五、六开放预约。在 45 分钟的体验中，你将品尝到三支当季单品豆，\n        并由我们的咖啡师为你演示完整的手冲流程——从研磨到第一口。\n      </p>\n      <a href=\"#\" class=\"cta-button reveal\" role=\"button\">预约体验</a>\n    </div>\n  </section>\n\n  <!-- ── Footer ── -->\n  <footer class=\"footer\" role=\"contentinfo\">\n    <div class=\"footer-inner\">\n      <span class=\"footer-brand\">ORIGAMI</span>\n      <nav class=\"footer-links\" aria-label=\"底部导航\">\n        <a href=\"#\">关于</a>\n        <a href=\"#\">门店</a>\n        <a href=\"#\">订阅</a>\n        <a href=\"#\">联系</a>\n      </nav>\n      <p class=\"footer-info\">© 2026 Origami Coffee Co.</p>\n    </div>\n  </footer>\n\n  <!-- ── Scroll Reveal ── -->\n  <script>\n    (function() {\n      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n      if (prefersReduced) {\n        document.querySelectorAll('.reveal').forEach(el => el.classList.add('visible'));\n        return;\n      }\n\n      const observer = new IntersectionObserver((entries) => {\n        entries.forEach(entry => {\n          if (entry.isIntersecting) {\n            entry.target.classList.add('visible');\n            observer.unobserve(entry.target);\n          }\n        });\n      }, {\n        threshold: 0.12,\n        rootMargin: '0px 0px -30px 0px'\n      });\n\n      document.querySelectorAll('.reveal').forEach(el => observer.observe(el));\n    })();\n  </script>\n</body>\n</html>\n"}]}}}
