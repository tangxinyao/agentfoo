{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": ["node", "vitest/globals"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": false,
    "paths": {
      "agentfoo": ["./src/index.ts"],
      "agentfoo/config": ["./src/config.ts"]
    }
  },
  // `test` is included deliberately: without it the renames and types this repo
  // spends effort keeping honest were only checked at runtime, and a stale
  // property name in a fixture surfaced as a mystery assertion failure instead of
  // a compile error.
  "include": ["src", "example", "test"]
}
